{
  "name": "sewa-monitoring-agent",
  "productName": "SEWA Monitoring Agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "dist": "npm --prefix .. run build:agent && npm run build && electron-builder --win nsis",
    "dist:mac": "npm --prefix .. run build:agent && npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sewa.monitoringagent",
    "npmRebuild": false,
    "productName": "SEWA Monitoring Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/node-gyp/**",
      "!node_modules/better-sqlite3/{deps,src,node_modules}/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/active-win/{Sources,binding.gyp}",
      "!node_modules/active-win/Sources/**"
    ],
    "extraResources": [
      {
        "from": "../dist/agent",
        "to": "agent"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/active-win/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SEWA-Monitoring-Agent-Setup-${version}.${ext}",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/!(win32-${arch}).node",
        "!node_modules/active-win/lib/binding/!(napi-6-win32-unknown-${arch})/**",
        "!node_modules/active-win/main"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "SEWA-Monitoring-Agent-${version}-macOS-${arch}.${ext}",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/!(darwin-${arch}).node",
        "!node_modules/active-win/lib/binding/!(napi-6-darwin-unknown-${arch})/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SEWA Monitoring Agent",
      "include": "build/installer.nsh"
    },
    "electronLanguages": [
      "en-US"
    ],
    "dmg": {
      "format": "UDBZ"
    }
  }
}
