{
  "name": "sewa-monitoring-agent",
  "productName": "SEWA Monitoring Agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && npm run electron:local -- .\"",
    "electron:local": "C:/Users/sonic/Downloads/electron-v40/electron.exe",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.sewa.monitoringagent",
    "productName": "SEWA Monitoring Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "agent",
        "filter": [
          "sewa-monitoring-agent.exe",
          "credential.ps1",
          "idleDetection.ps1",
          "singleInstance.ps1",
          "startAgent.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SEWA-Monitoring-Agent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SEWA Monitoring Agent",
      "include": "build/installer.nsh"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}